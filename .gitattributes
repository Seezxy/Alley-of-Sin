# Auto detect text files and perform LF normalization
* text=auto

# Python
*.py text eol=lf

# Documentation
*.md text eol=lf
*.txt text eol=lf

# Batch scripts must be CRLF on Windows
*.bat text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.pptx binary
*.json binary
